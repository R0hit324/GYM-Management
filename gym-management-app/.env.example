# Supabase client configuration for the Pulse Gym Expo app.
#
# Copy this file to `.env` and fill in the values from your Supabase
# project (Dashboard → Project Settings → API). `.env` is git-ignored;
# NEVER commit real credentials and NEVER use the service-role/secret
# key in the Expo app — only the publishable key below.
#
# These EXPO_PUBLIC_* variables are inlined into the client bundle at
# build time. That is safe: the publishable/anon key is public by
# design and all database access is controlled by RLS on the server.

# The project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Preferred: the publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects only: the anon key (JWT) may be used instead of the
# publishable key. Leave empty when the publishable key is set.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Auth provider selection. `demo` (default) keeps the in-memory demo provider
# and the visible demo labelling. `live` switches to Supabase Auth — only set
# it once the URL and publishable key above point at the intended project.
EXPO_PUBLIC_AUTH_MODE=demo
